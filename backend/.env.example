# Database
DATABASE_URL=postgresql+asyncpg://tattoo_user:tattoo_pass@localhost:5432/tattoo_db

# Security - REQUIRED: Must set strong secret key (min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Firebase Cloud Messaging (optional)
FCM_API_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# App
APP_NAME=TattooStudio API
APP_VERSION=1.0.0
DEBUG=true

# CORS - comma-separated list of allowed origins
# For production, set to your mobile app domain
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Default admin credentials (used in init_db.py)
# REQUIRED for first-time setup - use strong passwords!
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="admin@gmail.com"
SMTP_PASS="qpyo wapw zkyi ietl"
SMTP_FROM="Tattoo Studio <admin@gmail.com>"
USE_MOCK_EMAIL=false
